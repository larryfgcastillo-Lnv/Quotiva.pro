<script>
/* ================== ilustraciones de producto (SVG embebido) ================== */
function foto(tipo){
  const base = (inner,bg) => "data:image/svg+xml;utf8," + encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 150"><rect width="200" height="150" fill="${bg}"/>${inner}</svg>`);
  const s = {
    lamina: base(`<g fill="none" stroke="#8FA3B0" stroke-width="3"><path d="M20 100q10-16 20 0t20 0 20 0 20 0 20 0 20 0 20 0"/><path d="M20 84q10-16 20 0t20 0 20 0 20 0 20 0 20 0 20 0"/><path d="M20 68q10-16 20 0t20 0 20 0 20 0 20 0 20 0 20 0"/></g><path d="M20 100v14M180 100v14" stroke="#B7C6CF" stroke-width="3"/>`, "#EDF2F4"),
    tubo: base(`<rect x="34" y="52" width="132" height="46" fill="#C3D0D8" stroke="#8FA3B0" stroke-width="3"/><rect x="34" y="52" width="30" height="46" fill="#9FB2BD" stroke="#8FA3B0" stroke-width="3"/><rect x="42" y="60" width="14" height="30" fill="#EDF2F4" stroke="#8FA3B0" stroke-width="2"/>`, "#F1F5F6"),
    varilla: base(`<g stroke="#A6836A" stroke-width="9" stroke-linecap="round"><path d="M28 62h144M28 92h144"/></g><g stroke="#EDF2F4" stroke-width="3"><path d="M40 56l-8 12M70 56l-8 12M100 56l-8 12M130 56l-8 12M160 56l-8 12M40 86l-8 12M70 86l-8 12M100 86l-8 12M130 86l-8 12M160 86l-8 12"/></g>`, "#F4F0EC"),
    perfil: base(`<path d="M60 34h84v18H82v46h62v18H60z" fill="#C3D0D8" stroke="#8FA3B0" stroke-width="3"/>`, "#EEF3F5"),
    soldadura: base(`<rect x="52" y="48" width="96" height="62" fill="#D9BE8C" stroke="#A98F5E" stroke-width="3"/><path d="M52 68h96" stroke="#A98F5E" stroke-width="3"/><g stroke="#7C6845" stroke-width="4" stroke-linecap="round"><path d="M70 84h60M70 96h60"/></g>`, "#F6F1E7"),
    tornillo: base(`<path d="M84 36h32v22H84z" fill="#B9C6CE" stroke="#8FA3B0" stroke-width="3"/><path d="M92 58h16l-8 58z" fill="#C9D5DC" stroke="#8FA3B0" stroke-width="3"/><g stroke="#8FA3B0" stroke-width="2"><path d="M93 70h14M94 82h12M96 94h8"/></g>`, "#EFF3F5"),
  };
  return s[tipo];
}

/* ================== datos ================== */
let catalogo = [
  {sku:"LM-140", nombre:"Lámina galvanizada", desc:"Calibre 26 · 3.66 m", precio:18.40, unidad:"Lámina", icono:"lamina", img:"", activo:true},
  {sku:"TB-200", nombre:'Tubo estructural 2"', desc:"2\" x 2\" · pared 1.5 mm", precio:32.75, unidad:"Tubo", icono:"tubo", img:"", activo:true},
  {sku:"VR-38",  nombre:"Varilla corrugada #3", desc:"9 m · grado 40", precio:7.90, unidad:"Varilla", icono:"varilla", img:"", activo:true},
  {sku:"PF-500", nombre:'Perfil C 6"', desc:"6\" x 6 m · negro", precio:54.20, unidad:"Perfil", icono:"perfil", img:"", activo:true},
  {sku:"SL-010", nombre:"Soldadura 6013", desc:"Caja de 20 kg", precio:71.00, unidad:"Caja", icono:"soldadura", img:"", activo:true},
  {sku:"TR-025", nombre:"Tornillo autoperforante", desc:'Caja 500 u · 1"', precio:12.60, unidad:"Caja", icono:"tornillo", img:"", activo:true},
];
const imagenDe = p => imagenes[p.sku] || p.img || foto(p.icono || "tornillo");
const visibles = () => catalogo.filter(p=>p.activo);

const empresa = {
  nombre:"Aceros y Perfiles del Valle", logo:"", correo:"ventas@acerosvalle.hn",
  telefono:"+504 2200 1100", pais:"Honduras", direccion:"Blvd. Suyapa, Tegucigalpa",
  whatsapp:"50422001100", horario:"Lunes a viernes, 8:00 a 17:00",
  activo:true, diasVigencia:15,
  mensaje:"Hola {cliente}, hemos recibido su solicitud de cotización {folio}.\n\nPuede revisarla aquí:\n{enlace}\n\nGracias por contactar a {empresa}."
};

let promociones = [
  {id:1, nombre:"Lleve 5 y pague 4", tipo:"cantidad", x:5, y:1, sku:"VR-38",
   alcance:"todos", valor:"", hasta:fechaEn(45), activa:true},
  {id:2, nombre:"15% en láminas · Honduras", tipo:"porcentaje", pct:15, sku:"LM-140",
   alcance:"estado", valor:"Honduras", hasta:fechaEn(20), activa:true},
];
let promoId = 2;

const cotizaciones = [];
let consecutivo = 0;
const pedido = {};      // sku -> cantidad
let abierta = null;
let esAdmin = false;

/* ================== guardado permanente ================== */
const CLAVE = "smartquote.datos";
let modoMemoria = false, memoria = null, ultimoGuardado = "";

function paquete(){ return {catalogo, promociones, cotizaciones, usuarios, empresa, consecutivo, promoId, departamentos, opciones}; }
function guardar(){
  const t = JSON.stringify(paquete());
  if(t === ultimoGuardado) return;
  ultimoGuardado = t;
  try{ localStorage.setItem(CLAVE, t); }
  catch(e){ modoMemoria = true; memoria = t; }
}
function restaurar(){
  let d = null;
  try{ const t = localStorage.getItem(CLAVE); d = t ? JSON.parse(t) : null; }
  catch(e){ modoMemoria = true; d = memoria ? JSON.parse(memoria) : null; }
  if(!d) return;
  if(Array.isArray(d.catalogo) && d.catalogo.length) catalogo = d.catalogo;
  if(Array.isArray(d.promociones)) promociones = d.promociones;
  if(Array.isArray(d.cotizaciones)){ cotizaciones.length = 0; d.cotizaciones.forEach(q=>cotizaciones.push(q)); }
  if(Array.isArray(d.usuarios) && d.usuarios.length){ usuarios.length = 0; d.usuarios.forEach(u=>usuarios.push(u)); }
  if(d.empresa) Object.assign(empresa, d.empresa);
  if(typeof d.consecutivo === "number") consecutivo = d.consecutivo;
  if(typeof d.promoId === "number") promoId = d.promoId;
  if(Array.isArray(d.departamentos) && d.departamentos.length) departamentos = d.departamentos;
  if(d.opciones) Object.assign(opciones, d.opciones);
  catalogo.forEach(p=>{ if(!p.depto) p.depto = "General"; });
  departamentos = [...new Set([...departamentos, ...catalogo.map(p=>p.depto)])];
}

/* ---------- departamentos y opciones del catálogo ---------- */
let departamentos = ["General"];
const opciones = { mostrarPrecios:false, envioDefecto:0, verDestacados:true, tituloDestacados:"Los más vendidos" };

/* ---------- imágenes de producto (IndexedDB: soporta miles de productos) ---------- */
const imagenes = {};          // sku -> dataURL en memoria
let bd = null;
function abrirBD(){
  return new Promise(res=>{
    if(!window.indexedDB){ res(null); return; }
    const r = indexedDB.open("smartquote-img", 1);
    r.onupgradeneeded = ()=> r.result.createObjectStore("img");
    r.onsuccess = ()=> res(r.result);
    r.onerror = ()=> res(null);
  });
}
function imgGuardar(sku, dato){
  imagenes[sku] = dato;
  if(!bd) return;
  try{ bd.transaction("img","readwrite").objectStore("img").put(dato, sku); }catch(e){}
}
function imgBorrar(sku){
  delete imagenes[sku];
  if(!bd) return;
  try{ bd.transaction("img","readwrite").objectStore("img").delete(sku); }catch(e){}
}
function imgCargarTodas(){
  return new Promise(res=>{
    if(!bd){ res(); return; }
    try{
      const st = bd.transaction("img","readonly").objectStore("img");
      const cur = st.openCursor();
      cur.onsuccess = e=>{ const c = e.target.result; if(c){ imagenes[c.key] = c.value; c.continue(); } else res(); };
      cur.onerror = ()=> res();
    }catch(e){ res(); }
  });
}

