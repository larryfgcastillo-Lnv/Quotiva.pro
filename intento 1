    dom("d-catalogo").innerHTML = catalogo.map(p=>`<option value="${p.sku}">${escapar(p.nombre)} · ${money(p.precio)}</option>`).join("");
}
let imgTemporal = null;
/* lee el PNG/JPG elegido, lo reduce y lo convierte en dato guardable */
function leerImagen(input, max, cb){
  const f = input.files && input.files[0];
  if(!f){ cb(null); return; }
  const fr = new FileReader();
  fr.onload = ()=>{
    const im = new Image();
    im.onload = ()=>{
      const e = Math.min(1, max/Math.max(im.width, im.height));
      const cv = document.createElement("canvas");
      cv.width = Math.round(im.width*e); cv.height = Math.round(im.height*e);
      cv.getContext("2d").drawImage(im,0,0,cv.width,cv.height);
      cb(cv.toDataURL("image/png"));
    };
    im.onerror = ()=>cb(null);
    im.src = fr.result;
  };
  fr.readAsDataURL(f);
}
function leerFormProducto(){
  const previa = editandoSku ? (catalogo.find(p=>p.sku===editandoSku)||{}) : {};
  return {
    sku: dom("pd-sku").value.trim().toUpperCase(),
    nombre: dom("pd-nombre").value.trim(),
    desc: dom("pd-desc").value.trim(),
    precio: +dom("pd-precio").value || 0,
    unidad: dom("pd-unidad").value.trim() || "Unidad",
    depto: dom("pd-depto").value || "General",
    destacado: dom("pd-destacado").checked,
    ocultarPrecio: dom("pd-sinprecio").checked,
    img: "",
    icono: dom("pd-icono").value,
    activo: dom("pd-activo").checked,
  };
}
function previewProducto(){
  const p = leerFormProducto();
  if(imgTemporal) p.img = imgTemporal;
  if(!p.nombre) p.nombre = "Nombre del producto";
  if(!p.sku) p.sku = "SKU";
  dom("pd-preview").innerHTML = tarjeta(p, 0, true);
}
["pd-sku","pd-nombre","pd-desc","pd-unidad"].forEach(id=> dom(id).addEventListener("input", previewProducto));
dom("pd-icono").addEventListener("change", previewProducto);
dom("pd-depto").addEventListener("change", previewProducto);
["pd-destacado","pd-sinprecio"].forEach(id=> dom(id).addEventListener("change", previewProducto));
dom("pd-archivo").addEventListener("change", ()=> leerImagen(dom("pd-archivo"), 700, d=>{
  if(!d){ toast("No se pudo leer la imagen."); return; }
  imgTemporal = d; previewProducto(); toast("Imagen cargada.");
}));
function limpiarFormProducto(){
  editandoSku = null; imgTemporal = null;
  ["pd-sku","pd-nombre","pd-desc"].forEach(id=> dom(id).value="");
  if(departamentos.length) dom("pd-depto").value = departamentos[0];
  dom("pd-archivo").value = "";
  dom("pd-precio").value = 0; dom("pd-unidad").value = "Unidad";
  dom("pd-activo").checked = true; dom("pd-sku").disabled = false;
  dom("pd-destacado").checked = false; dom("pd-sinprecio").checked = false;
  dom("pd-titulo").textContent = "Nuevo producto";
  dom("pd-cancelar").style.display = "none";
  previewProducto();
}
function editarProducto(sku){
  const p = catalogo.find(x=>x.sku===sku);
  editandoSku = sku; imgTemporal = null;
  dom("pd-sku").value = p.sku; dom("pd-sku").disabled = true;
  dom("pd-nombre").value = p.nombre; dom("pd-desc").value = p.desc;
  dom("pd-precio").value = p.precio; dom("pd-unidad").value = p.unidad||"Unidad";
  dom("pd-archivo").value = ""; dom("pd-icono").value = p.icono||"tornillo";
  dom("pd-depto").value = p.depto||"General";
  dom("pd-activo").checked = p.activo;
  dom("pd-destacado").checked = !!p.destacado;
  dom("pd-sinprecio").checked = !!p.ocultarPrecio;
  dom("pd-titulo").textContent = "Editar " + p.sku;
  dom("pd-cancelar").style.display = "inline-flex";
  previewProducto();
  dom("pd-titulo").scrollIntoView({behavior:"smooth", block:"nearest"});
}
dom("pd-cancelar").onclick = limpiarFormProducto;
dom("pd-guardar").onclick = ()=>{
  const p = leerFormProducto();
  if(!p.sku || !p.nombre){ toast("El código y el nombre son obligatorios."); return; }
  if(p.precio<=0){ toast("Indique el precio de lista, aunque sea provisional."); return; }
  if(editandoSku){
    const i = catalogo.findIndex(x=>x.sku===editandoSku);
    catalogo[i] = {...catalogo[i], ...p, sku:editandoSku, img:""};
    if(imgTemporal) imgGuardar(editandoSku, imgTemporal);
    cotizaciones.forEach(q=> q.lineas.forEach(l=>{ if(l.sku===editandoSku) l.nombre = p.nombre; }));
    toast("Producto actualizado.");
  } else {
    if(catalogo.some(x=>x.sku===p.sku)){ toast("Ya existe un producto con ese código."); return; }
    catalogo.push(p);
    if(imgTemporal) imgGuardar(p.sku, imgTemporal);
    toast("Producto agregado al catálogo.");
  }
  guardar(); limpiarFormProducto();
  pintarProductos(); pintarChips(); pintarCatalogo(); pintarResumen();
  if(abierta) pintarLineas(abierta);
};

/* ================== configuración ================== */
const campos = {"g-nombre":"nombre","g-logo":"logo","g-mail":"correo","g-tel":"telefono","g-pais":"pais","g-dir":"direccion","g-wa":"whatsapp","g-horario":"horario","g-msg":"mensaje"};
function cargarConfig(){
  for(const [id,k] of Object.entries(campos)) dom(id).value = empresa[k];
  dom("g-activo").checked = empresa.activo; dom("g-dias").value = empresa.diasVigencia;
  dom("g-precios").checked = !!opciones.mostrarPrecios;
  previewConfig(); pintarCuentas();
}
function codigoNuevo(){
  const a = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
  const t = [...crypto.getRandomValues(new Uint8Array(8))].map(b=>a[b%a.length]).join("");
  return t.slice(0,4)+"-"+t.slice(4);
}
function asegurarCodigos(){ usuarios.forEach(u=>{ if(!u.codigo) u.codigo = codigoNuevo(); }); }
function pintarCuentas(){
  if(!dom("cu-lista")) return;
  dom("cu-lista").innerHTML = usuarios.map((u,i)=>`
    <div class="promo-card"><div class="body">
      <h4>${escapar(u.nombre)} <span class="pill ${u.rol==="admin"?"s-enviada":"s-aceptada"}">${u.rol}</span></h4>
      <div class="hint" style="margin:0">Usuario: ${escapar(u.usuario)}${u.correo?" · "+escapar(u.correo):""}</div>
      <div class="hint" style="margin:2px 0 0">Código de recuperación: <span class="token">${escapar(u.codigo)}</span></div>
    </div>
    <div style="display:flex;gap:6px;flex-direction:column">
      <button class="btn ghost sm" data-cu="${i}">Cambiar contraseña</button>
      <button class="btn ghost sm" data-cd="${i}">Nuevo código</button>
    </div></div>`).join("");
  dom("cu-lista").querySelectorAll("[data-cu]").forEach(b=> b.onclick = ()=>{
    const u = usuarios[+b.dataset.cu];
    const nueva = prompt("Nueva contraseña para "+u.nombre+":");
    if(!nueva || nueva.length<4){ toast("La contraseña debe tener al menos 4 caracteres."); return; }
    u.clave = nueva; guardar(); toast("Contraseña actualizada para "+u.nombre+".");
  });
  dom("cu-lista").querySelectorAll("[data-cd]").forEach(b=> b.onclick = ()=>{
    const u = usuarios[+b.dataset.cd];
    u.codigo = codigoNuevo(); guardar(); pintarCuentas();
    toast("Nuevo código generado. Anótelo y entrégueselo al usuario.");
  });
  const conImg = Object.keys(imagenes).length;
  dom("cu-stats").innerHTML = `
    <dt>Productos</dt><dd>${catalogo.length}</dd>
    <dt>Departamentos</dt><dd>${departamentos.length}</dd>
    <dt>Con imagen</dt><dd>${conImg}</dd>
    <dt>Cotizaciones</dt><dd>${cotizaciones.length}</dd>
    <dt>Imágenes</dt><dd>${bd? "Base de datos del navegador" : "Modo básico"}</dd>`;
}
function previewConfig(){
  burbuja(dom("g-preview"), dom("g-msg").value
    .replaceAll("{cliente}", dom("c-nombre").value||"María Rentería")
    .replaceAll("{folio}","#QT-2026-00042")
    .replaceAll("{enlace}","empresa.com/cotizacion/QT-2026-00042?t=a1b2c3d4")
    .replaceAll("{empresa}", dom("g-nombre").value));
  dom("g-preview-num").textContent = "De +"+dom("g-wa").value.replace(/\D/g,"")+(dom("g-activo").checked?"":" · WhatsApp desactivado");
}
["g-msg","g-nombre","g-wa"].forEach(id=> dom(id).addEventListener("input",previewConfig));
dom("g-activo").addEventListener("change",previewConfig);
dom("g-guardar").onclick = ()=>{
  for(const [id,k] of Object.entries(campos)) empresa[k]=dom(id).value;
  empresa.activo = dom("g-activo").checked;
  empresa.diasVigencia = Math.max(1,+dom("g-dias").value||15);
  opciones.mostrarPrecios = dom("g-precios").checked;
  if(dom("op-precios")) dom("op-precios").checked = opciones.mostrarPrecios;
  guardar(); pintarCatalogo(); pintarResumen();
  if(abierta) pintarMensaje(abierta);
  toast("Configuración guardada para "+empresa.nombre+".");
};

/* ================== arranque ================== */
async function iniciar(){
  restaurar();
  asegurarCodigos();
  catalogo.forEach(p=>{ if(!p.depto) p.depto = "General"; });
  departamentos = [...new Set([...departamentos, ...catalogo.map(p=>p.depto)])];
  bd = await abrirBD();
  await imgCargarTodas();
  dom("pr-fecha").value = fechaEn(30);
  camposPromo(); pintarSelectProductos(); pintarDeptos(); cargarOpciones();
  pintarProductos(); pintarChips(); pintarCatalogo(); pintarResumen();
  pintarPromos(); pintarLista(); cargarConfig(); aplicarSesion();
  guardar();
}
iniciar();

/* los datos se guardan solos: al cambiar algo, al cerrar y cada dos segundos */
setInterval(guardar, 2000);
window.addEventListener("beforeunload", guardar);
document.addEventListener("visibilitychange", ()=>{ if(document.hidden) guardar(); });
if(modoMemoria) toast("Este navegador no permite guardar datos. Descargue el archivo y ábralo desde su equipo para conservar las cotizaciones.");
</script>
