};
dom("d-wa").onclick = ()=>{
  if(abierta.estado==="Nueva" || abierta.estado==="En revisión"){
    abierta.estado="Enviada"; dom("d-cambiar").value="Enviada"; dom("d-estado").innerHTML=pill(abierta.estado);
