};

/* ================== catálogo administrable ================== */
let editandoSku = null;
let pagina = 0;
const POR_PAGINA = 50;
function productosFiltrados(){
  const q = (dom("fl-buscar").value||"").trim().toLowerCase();
  const d = dom("fl-depto").value, v = dom("fl-visible").value;
  return catalogo.filter(p=>{
    if(d && (p.depto||"General")!==d) return false;
    if(v==="1" && !p.activo) return false;
    if(v==="0" && p.activo) return false;
    if(q && !((p.nombre+" "+p.sku+" "+p.desc).toLowerCase().includes(q))) return false;
    return true;
  });
}
["fl-buscar","fl-depto","fl-visible"].forEach(id=>{
  dom(id).addEventListener("input", ()=>{ pagina=0; pintarProductos(); });
  dom(id).addEventListener("change", ()=>{ pagina=0; pintarProductos(); });
});
dom("pg-ant").onclick = ()=>{ if(pagina>0){ pagina--; pintarProductos(); } };
dom("pg-sig").onclick = ()=>{ const t=productosFiltrados().length; if((pagina+1)*POR_PAGINA<t){ pagina++; pintarProductos(); } };

function pintarProductos(){
  const filtrados = productosFiltrados();
  const total = filtrados.length;
  const desde = Math.min(pagina*POR_PAGINA, Math.max(0,total-1));
  const pagina_ = filtrados.slice(desde, desde+POR_PAGINA);
  dom("fl-conteo").textContent = total + " de " + catalogo.length + " producto(s)";
  dom("pg-info").textContent = total ? (desde+1)+"–"+Math.min(desde+POR_PAGINA,total)+" de "+total : "0";
  dom("pg-ant").disabled = pagina===0;
  dom("pg-sig").disabled = (pagina+1)*POR_PAGINA >= total;
  dom("pd-filas").innerHTML = total ? pagina_.map(p=>`
    <tr>
      <td style="padding-left:14px"><img src="${imagenDe(p)}" alt="" style="width:46px;height:36px;object-fit:cover;border-radius:3px;border:1px solid var(--line)"></td>
      <td>${escapar(p.nombre)}<div class="hint mono">${escapar(p.sku)} · ${escapar(p.desc)}</div></td>
      <td>${escapar(p.depto||"General")}<div class="hint">${escapar(p.unidad||"Unidad")}</div></td>
      <td class="num">${money(p.precio)}${p.ocultarPrecio?'<div class="hint">precio oculto</div>':""}</td>
      <td>${p.activo?'<span class="pill s-aceptada">Visible</span>':'<span class="pill s-vencida">Oculto</span>'}</td>
      <td class="num"><div class="btn-row" style="justify-content:flex-end">
        <button class="btn ghost sm" data-ed="${p.sku}">Editar</button>
        <button class="btn ghost sm" data-top="${p.sku}">${p.destacado?"★ Quitar":"☆ Más vendido"}</button>
        <button class="btn ghost sm" data-vis="${p.sku}">${p.activo?"Ocultar":"Mostrar"}</button>
        <button class="btn danger sm" data-del="${p.sku}">Eliminar</button>
      </div></td></tr>`).join("")
    : `<tr><td colspan="6" class="empty">${catalogo.length? "Ningún producto coincide con el filtro." : "Sin productos. Agregue el primero con el formulario."}</td></tr>`;

  dom("pd-filas").querySelectorAll("[data-ed]").forEach(b=> b.onclick = ()=> editarProducto(b.dataset.ed));
  dom("pd-filas").querySelectorAll("[data-top]").forEach(b=> b.onclick = ()=>{
    const p = catalogo.find(x=>x.sku===b.dataset.top); p.destacado = !p.destacado; guardar();
    pintarProductos(); pintarCatalogo(); pintarDestacados();
    toast(p.destacado? "Agregado a los más vendidos." : "Quitado de los más vendidos.");
  });
  dom("pd-filas").querySelectorAll("[data-vis]").forEach(b=> b.onclick = ()=>{
    const p = catalogo.find(x=>x.sku===b.dataset.vis); p.activo = !p.activo; guardar();
    pintarProductos(); pintarChips(); pintarCatalogo();
    toast(p.activo? "Producto visible en el catálogo." : "Producto oculto para los clientes.");
  });
  dom("pd-filas").querySelectorAll("[data-del]").forEach(b=> b.onclick = ()=>{
    const sku = b.dataset.del;
    if(cotizaciones.some(q=> q.lineas.some(l=>l.sku===sku))){
      toast("Ese producto está en cotizaciones existentes. Ocúltelo en lugar de eliminarlo."); return;
    }
    catalogo = catalogo.filter(x=>x.sku!==sku); delete pedido[sku]; imgBorrar(sku); guardar();
    if(editandoSku===sku) limpiarFormProducto();
    pintarProductos(); pintarChips(); pintarCatalogo(); pintarResumen(); pintarSelectProductos();
    toast("Producto eliminado.");
  });
  pintarSelectProductos(); pintarDeptos(); pintarDestacados(); previewProducto();
}
