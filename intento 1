};
dom("d-pdf").onclick = ()=>{ registrar(abierta,"PDF generado"); toast("PDF generado (simulado en este prototipo)."); };
dom("d-enviar").onclick = ()=>{
  abierta.estado="Enviada"; dom("d-cambiar").value="Enviada"; dom("d-estado").innerHTML=pill(abierta.estado);
  registrar(abierta,"Cotización enviada al cliente"); toast("Cotización enviada a "+abierta.correo);
};

/* ================== panel de promociones ================== */
function pintarPromos(){
  dom("pr-lista").innerHTML = promociones.length ? promociones.map(p=>{
    const venc = !vigente(p);
    const alcance = p.alcance==="todos" ? "Todos los clientes"
      : p.alcance==="cliente" ? "Cliente: "+p.valor : "Zona: "+p.valor;
    return `<div class="promo-card ${venc?"off":""}"><div class="body">
      <h4>${escapar(p.nombre)}</h4>
      <div class="hint" style="margin:0">${escapar(textoPromo(p))} · ${p.sku? p.sku : "todos los productos"}</div>
      <div class="hint" style="margin:2px 0 0">${escapar(alcance)} · válida hasta ${fmt(p.hasta)}${venc?" · vencida o inactiva":""}</div>
    </div>
    <div style="display:flex;gap:6px;flex-direction:column">
      <button class="btn ghost sm" data-t="${p.id}">${p.activa?"Desactivar":"Activar"}</button>
      <button class="btn danger sm" data-x="${p.id}">Eliminar</button>
    </div></div>`;
  }).join("") : `<p class="hint" style="margin:0">Todavía no hay promociones. Cree la primera con el formulario.</p>`;
  dom("pr-lista").querySelectorAll("[data-t]").forEach(b=> b.onclick = ()=>{
    const p = promociones.find(x=>x.id===+b.dataset.t); p.activa=!p.activa;
    pintarPromos(); pintarCatalogo(); if(abierta){ pintarLineas(abierta); pintarPromosCliente(abierta); }
    toast("Promoción "+(p.activa?"activada":"desactivada")+".");
  });
  dom("pr-lista").querySelectorAll("[data-x]").forEach(b=> b.onclick = ()=>{
    const id=+b.dataset.x;
    promociones = promociones.filter(x=>x.id!==id);
    cotizaciones.forEach(q=> q.lineas.forEach(l=>{ if(l.promoId===id) l.promoId=null; }));
    pintarPromos(); pintarCatalogo(); if(abierta){ pintarLineas(abierta); pintarPromosCliente(abierta); }
    toast("Promoción eliminada.");
  });
}
function camposPromo(){
  const tipo = dom("pr-tipo").value, alc = dom("pr-alcance").value;
  dom("pr-campos-cantidad").style.display = tipo==="cantidad" ? "grid" : "none";
  dom("pr-campo-pct").style.display = tipo==="porcentaje" ? "block" : "none";
  dom("pr-campo-valor").style.display = alc==="todos" ? "none" : "block";
  dom("pr-valor-lbl").textContent = alc==="cliente" ? "Nombre del cliente o empresa" : "Ciudad, estado o país";
}
dom("pr-tipo").onchange = camposPromo;
dom("pr-alcance").onchange = camposPromo;
dom("pr-crear").onclick = ()=>{
  const nombre = dom("pr-nombre").value.trim();
  const alc = dom("pr-alcance").value, valor = dom("pr-valor").value.trim();
  if(!nombre){ toast("Escriba un nombre para la promoción."); return; }
  if(!dom("pr-fecha").value){ toast("Indique hasta qué fecha es válida."); return; }
  if(alc!=="todos" && !valor){ toast("Indique el cliente o la zona donde aplica."); return; }
  const p = {
    id: ++promoId, nombre, tipo: dom("pr-tipo").value,
    x: +dom("pr-x").value||5, y: +dom("pr-y").value||1, pct: +dom("pr-pct").value||10,
    sku: dom("pr-producto").value, alcance: alc, valor, hasta: dom("pr-fecha").value, activa:true
  };
