<!-- Quotiva PRO · catálogo con fotos, panel administrativo protegido y promociones -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Quotiva PRO</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">

<style>
:root{
  --ink:#14202E; --ink-soft:#3D4E5F; --slate:#6B7C8C;
  --line:#D2DBE0; --paper:#FFFFFF; --wash:#E7EDEF;
  --teal:#06786B; --teal-ink:#04544B; --amber:#C98A16; --rose:#A83247;
  --radius:4px;
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--wash);color:var(--ink);font-family:"IBM Plex Sans",system-ui,sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:"Bricolage Grotesque",system-ui,sans-serif;font-weight:700;letter-spacing:-.02em;margin:0}
.mono{font-family:"IBM Plex Mono",monospace}
button{font:inherit}
a{color:var(--teal-ink)}
:focus-visible{outline:2px solid var(--teal);outline-offset:2px}

header.top{background:var(--ink);color:#fff;padding:14px 20px;display:flex;gap:18px;align-items:center;flex-wrap:wrap;position:sticky;top:0;z-index:20}
header.top .brand{font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:17px;letter-spacing:-.02em}
header.top .brand span{color:#7FD8C6}
nav.tabs{display:flex;gap:4px;margin-left:auto;flex-wrap:wrap;align-items:center}
nav.tabs button{background:transparent;border:1px solid transparent;color:#B9C7D2;padding:6px 12px;border-radius:var(--radius);cursor:pointer;font-size:13.5px}
nav.tabs button:hover{color:#fff;border-color:#31445A}
nav.tabs button[aria-selected="true"]{background:#fff;color:var(--ink);font-weight:600}
.lock{font-size:11px;font-family:"IBM Plex Mono",monospace;color:#7FD8C6;letter-spacing:.08em}
main{max-width:1180px;margin:0 auto;padding:26px 20px 90px}
.view{display:none}.view.on{display:block}
.eyebrow{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--slate);margin-bottom:6px}
.page-head{margin-bottom:22px;max-width:62ch}
.page-head p{color:var(--ink-soft);margin:8px 0 0}
.card{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:20px}
.card + .card{margin-top:16px}
.card h3{font-size:16px;margin-bottom:14px}
.grid2{display:grid;gap:16px;grid-template-columns:1fr 1fr}
.split{display:grid;gap:16px;grid-template-columns:1.55fr 1fr;align-items:start}
@media(max-width:860px){.grid2,.split{grid-template-columns:1fr}}

label.f{display:block;margin-bottom:12px}
label.f > span{display:block;font-size:12.5px;font-weight:600;color:var(--ink-soft);margin-bottom:4px}
input[type=file]{padding:7px;font-size:13px}
.chips{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px}
.chip{border:1px solid var(--line);background:#fff;border-radius:99px;padding:6px 14px;cursor:pointer;font-size:13.5px;color:var(--ink-soft)}
.chip[aria-pressed="true"]{background:var(--teal);border-color:var(--teal);color:#fff;font-weight:600}
.seccion{margin:0 0 10px;font-size:15px;display:flex;align-items:baseline;gap:10px}
.seccion small{font-family:"IBM Plex Mono",monospace;font-size:11px;color:var(--slate);font-weight:400;letter-spacing:.08em}
.bloque + .bloque{margin-top:24px}
.barra{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px}
.barra input,.barra select{width:auto;min-width:170px}
.pag{display:flex;gap:8px;align-items:center;justify-content:flex-end;padding:12px 10px 0}
.prod .precio{font-family:"IBM Plex Mono",monospace;font-weight:600;margin-top:2px}
input,select,textarea{width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:var(--radius);background:#fff;font:inherit;color:var(--ink)}
textarea{min-height:78px;resize:vertical}
input:focus,select:focus,textarea:focus{border-color:var(--teal);outline:none;box-shadow:0 0 0 3px rgba(6,120,107,.12)}
.hint{font-size:12px;color:var(--slate);margin-top:4px}

.btn{display:inline-flex;align-items:center;gap:8px;justify-content:center;padding:9px 15px;border-radius:var(--radius);border:1px solid var(--ink);background:var(--ink);color:#fff;cursor:pointer;font-size:14px;font-weight:500}
.btn:hover{background:#1E3145}
.btn.ghost{background:#fff;color:var(--ink)}
.btn.ghost:hover{background:#F0F4F5}
.btn.wa{background:var(--teal);border-color:var(--teal)}
.btn.wa:hover{background:var(--teal-ink)}
.btn.sm{padding:6px 11px;font-size:13px}
.btn.danger{background:#fff;color:var(--rose);border-color:#E3C3CA}
.btn-row{display:flex;gap:8px;flex-wrap:wrap}

/* ---------- catálogo con fotos ---------- */
.catalogo{display:grid;gap:14px;grid-template-columns:repeat(auto-fill,minmax(215px,1fr))}
.prod{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column}
.prod.activo{border-color:var(--teal);box-shadow:0 0 0 2px rgba(6,120,107,.14)}
.prod .foto{aspect-ratio:4/3;background:#F1F5F6;border-bottom:1px solid var(--line)}
.prod .foto img{width:100%;height:100%;object-fit:cover;display:block}
.prod .cuerpo{padding:12px 13px 13px;display:flex;flex-direction:column;gap:4px;flex:1}
.prod .sku{font-family:"IBM Plex Mono",monospace;font-size:10.5px;letter-spacing:.1em;color:var(--slate)}
.prod .nom{font-weight:600;font-size:14.5px;line-height:1.3}
.prod .desc{font-size:12.5px;color:var(--slate)}
.prod .precio{font-family:"IBM Plex Mono",monospace;font-weight:600;margin-top:2px}
.prod .pie{margin-top:auto;padding-top:11px}
.stepper{display:flex;align-items:center;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
.stepper button{width:38px;height:36px;border:0;background:#F4F8F8;color:var(--ink);font-size:17px;cursor:pointer;line-height:1}
.stepper button:hover{background:#E4EFEE;color:var(--teal-ink)}
.stepper .val{flex:1;text-align:center;font-family:"IBM Plex Mono",monospace;font-weight:600;border:0;border-left:1px solid var(--line);border-right:1px solid var(--line);border-radius:0;padding:8px 2px;min-width:52px;background:#fff;-moz-appearance:textfield}
.stepper .val:focus{outline:none;box-shadow:inset 0 0 0 2px rgba(6,120,107,.18)}
.stepper .val::-webkit-outer-spin-button,.stepper .val::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.add{width:100%;border:1px dashed var(--line);background:#fff;color:var(--ink-soft);padding:8px;border-radius:var(--radius);cursor:pointer;font-size:13.5px}
.add:hover{border-color:var(--teal);color:var(--teal-ink);border-style:solid}
.promo-tag{display:inline-block;font-size:11px;font-family:"IBM Plex Mono",monospace;color:var(--teal-ink);background:#E8F3F1;border-radius:3px;padding:2px 6px;margin-top:2px}

.resumen{position:sticky;top:76px}
.resumen ul{list-style:none;margin:0;padding:0;font-size:14px}
.resumen li{display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-bottom:1px solid #EDF1F3}
.resumen li span.q{font-family:"IBM Plex Mono",monospace;color:var(--slate)}

.folio{display:inline-block;background:var(--ink);color:#EAF6F3;font-family:"IBM Plex Mono",monospace;font-weight:600;letter-spacing:.06em;padding:7px 14px;border-radius:var(--radius);position:relative}
.folio::before,.folio::after{content:"";position:absolute;top:50%;width:9px;height:9px;border-radius:50%;background:var(--wash);transform:translateY(-50%)}
.folio::before{left:-5px}.folio::after{right:-5px}
.folio.big{font-size:19px;padding:10px 18px}
.card .folio::before,.card .folio::after{background:var(--paper)}

.pill{display:inline-block;font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:3px 8px;border-radius:99px;border:1px solid currentColor}
.s-nueva{color:var(--teal-ink)}.s-revision{color:var(--amber)}.s-enviada{color:#2C5FA8}
.s-aceptada{color:#2F7D3A}.s-vencida{color:var(--rose)}

table{width:100%;border-collapse:collapse;font-size:14px}
th{text-align:left;font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--slate);font-weight:500;padding:0 10px 8px;border-bottom:1px solid var(--line)}
td{padding:11px 10px;border-bottom:1px solid #EDF1F3;vertical-align:middle}
tbody tr.clickable{cursor:pointer}
tbody tr.clickable:hover{background:#F4F8F8}
td.num,th.num{text-align:right;font-family:"IBM Plex Mono",monospace}
td input,td select{padding:5px 7px;font-size:13.5px}
.w-70{width:70px}.w-90{width:90px}
.empty{padding:34px 10px;text-align:center;color:var(--slate)}
.new-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--teal);margin-right:7px}

.wa-preview{background:#DCE7E3;border-radius:var(--radius);padding:16px;border:1px solid #C3D4CF}
.wa-bubble{background:#fff;border-radius:2px 10px 10px 10px;padding:11px 13px;font-size:14px;white-space:pre-wrap;box-shadow:0 1px 2px rgba(20,32,46,.14);max-width:36ch}
.wa-bubble .lnk{color:#0A6ED1;word-break:break-all}
.wa-meta{font-size:11px;color:#5E7169;margin-top:8px;font-family:"IBM Plex Mono",monospace}

.kv{display:grid;grid-template-columns:auto 1fr;gap:7px 16px;font-size:14px}
.kv dt{color:var(--slate);font-size:12.5px;padding-top:1px}
.kv dd{margin:0;font-weight:500}
.timeline{list-style:none;margin:0;padding:0;font-size:13.5px}
.timeline li{padding:0 0 12px 16px;border-left:1px solid var(--line);position:relative}
.timeline li::before{content:"";position:absolute;left:-3.5px;top:6px;width:6px;height:6px;border-radius:50%;background:var(--teal)}
.timeline time{display:block;font-family:"IBM Plex Mono",monospace;font-size:11px;color:var(--slate)}
.toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(140%);background:var(--ink);color:#fff;padding:11px 18px;border-radius:var(--radius);font-size:14px;z-index:50;transition:transform .28s ease;max-width:90vw}
.toast.on{transform:translateX(-50%) translateY(0)}
.notice{border-left:3px solid var(--teal);background:#F1F7F6;padding:11px 14px;font-size:13.5px;color:var(--ink-soft);border-radius:0 var(--radius) var(--radius) 0}
.notice.warn{border-color:var(--amber);background:#FBF5E9}
.token{font-family:"IBM Plex Mono",monospace;font-size:12.5px;background:#F0F4F5;padding:2px 6px;border-radius:3px;word-break:break-all}
.sep{height:1px;background:var(--line);margin:18px 0}
.login{max-width:390px;margin:60px auto}
.promo-card{border:1px solid var(--line);border-radius:var(--radius);padding:14px;display:flex;gap:14px;align-items:flex-start}
.promo-card + .promo-card{margin-top:10px}
.promo-card .body{flex:1}
.promo-card h4{margin:0 0 3px;font-family:"Bricolage Grotesque",sans-serif;font-size:15px}
.promo-card.off{opacity:.55}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

<header class="top">
  <div class="brand">Quotiva<span> PRO</span></div>
  <nav class="tabs" role="tablist" id="tabs"></nav>
  <div class="tabs" style="margin-left:0;gap:10px">
    <span class="lock" id="sesion"></span>
    <button id="entrar-nav">Iniciar sesión</button>
    <button id="salir" style="display:none">Cerrar sesión</button>
  </div>
</header>

<main>

<!-- ============ CLIENTE ============ -->
<section class="view on" id="v-cliente">
  <div class="page-head">
    <p class="eyebrow">Catálogo público</p>
    <h1>Arme su cotización</h1>
    <p>Elija los productos y ajuste las cantidades. Al enviar, su solicitud llega al WhatsApp de la empresa con el folio y el enlace de seguimiento.</p>
  </div>

  <div class="split">
    <div>
      <div class="barra">
        <input id="k-buscar" placeholder="Buscar producto o código…">
        <span class="hint" id="k-conteo" style="margin:0"></span>
      </div>
      <div class="chips" id="k-chips"></div>
      <div id="catalogo"></div>

      <div class="card" style="margin-top:16px">
        <h3>Sus datos de contacto</h3>
        <div class="grid2">
          <label class="f"><span>Nombre</span><input id="c-nombre" placeholder="Escriba su nombre"></label>
          <label class="f"><span>Empresa</span><input id="c-empresa" placeholder="Nombre de su empresa"></label>
          <label class="f"><span>País</span>
            <select id="c-pais"><option value="">Seleccione…</option><option>Honduras</option><option>México</option><option>Guatemala</option><option>Costa Rica</option><option>Colombia</option><option>Estados Unidos</option></select></label>
          <label class="f"><span>Ciudad o estado</span><input id="c-ciudad" placeholder="Ciudad o estado"></label>
          <label class="f"><span>Teléfono</span><input id="c-tel" placeholder="+504 0000 0000"></label>
          <label class="f"><span>WhatsApp</span><input id="c-wa" placeholder="+504 0000 0000">
            <span class="hint">Con código de país, para que la empresa pueda responderle.</span></label>
        </div>
        <label class="f"><span>Correo electrónico</span><input id="c-mail" type="email" placeholder="correo@dominio.com"></label>
        <label class="f"><span>Comentarios adicionales</span>
          <textarea id="c-coment" placeholder="Plazos de entrega, especificaciones, condiciones de pago…"></textarea></label>
      </div>
    </div>

    <div class="card resumen">
      <h3>Su pedido</h3>
      <ul id="c-resumen"></ul>
      <div style="display:flex;justify-content:space-between;margin-top:12px;align-items:baseline">
        <span class="eyebrow" style="margin:0">Unidades</span>
        <span class="mono" style="font-size:19px;font-weight:600" id="c-total">0 u</span>
      </div>
      <p class="hint">Los precios se calculan con las promociones que apliquen y se los enviamos en la cotización.</p>
      <button class="btn wa" id="c-generar" style="width:100%;margin-top:8px">Enviar solicitud por WhatsApp</button>
    </div>
  </div>

  <div class="card" id="c-recibo" style="display:none;margin-top:16px">
    <h3>Solicitud registrada</h3>
    <div class="split">
      <div>
        <div class="folio big" id="r-folio">QT-2026-00000</div>
        <dl class="kv" style="margin-top:16px">
          <dt>Enlace</dt><dd><span class="token" id="r-link"></span></dd>
          <dt>Vence</dt><dd id="r-vence"></dd>
          <dt>Estado</dt><dd><span class="pill s-nueva">Nueva</span></dd>
        </dl>
        <div class="btn-row" style="margin-top:16px">
          <button class="btn wa" id="r-wa">Abrir WhatsApp de la empresa</button>
        </div>
        <p class="hint">La solicitud ya quedó guardada. El botón abre la conversación con el mensaje escrito; solo debe presionar enviar.</p>
      </div>
      <div class="wa-preview">
        <div class="wa-bubble" id="r-msg"></div>
        <div class="wa-meta" id="r-num"></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ PANEL (protegido) ============ -->
<section class="view" id="v-panel">
  <div class="card login" id="p-login">
    <p class="eyebrow">Área restringida</p>
    <h1 style="font-size:22px;margin-bottom:6px">Solo administradores</h1>
    <p class="hint">Las solicitudes de los clientes solo son visibles para la cuenta de administrador de la empresa.</p>
    <button class="btn" style="margin-top:14px" onclick="mostrar('acceso')">Iniciar sesión</button>
  </div>

  <div id="p-lista" style="display:none">
    <div class="page-head">
      <p class="eyebrow">Bandeja de solicitudes</p>
      <h1>Cotizaciones recibidas</h1>
      <p>Las solicitudes llegan aquí en el mismo orden en que entraron al WhatsApp de la empresa. Abra una para revisarla y responder.</p>
    </div>
    <div class="notice" id="p-aviso" style="margin-bottom:16px"></div>
    <div class="card" style="padding:20px 12px">
      <table>
        <thead><tr>
          <th style="padding-left:14px">Folio</th><th>Cliente</th><th>Empresa</th>
          <th>Ciudad / País</th><th>Recibida</th><th class="num">Total</th><th>Estado</th>
        </tr></thead>
        <tbody id="p-filas"></tbody>
      </table>
    </div>
  </div>

  <div id="p-detalle" style="display:none">
    <button class="btn ghost sm" id="d-volver" style="margin-bottom:18px">← Volver a la bandeja</button>
    <div class="split">
      <div>
        <div class="card">
          <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-bottom:16px">
            <span class="folio big" id="d-folio"></span>
            <span id="d-estado"></span>
            <select id="d-cambiar" style="width:auto;margin-left:auto">
              <option>Nueva</option><option>En revisión</option><option>Enviada</option><option>Aceptada</option><option>Vencida</option>
            </select>
          </div>
          <dl class="kv" id="d-info"></dl>
        </div>

        <div class="card">
          <h3>Productos solicitados</h3>
          <table>
            <thead><tr>
              <th>Producto</th><th class="num w-70">Cant.</th><th class="num w-90">Precio</th>
              <th>Promoción</th><th class="num w-70">Desc. %</th><th class="num">Subtotal</th>
            </tr></thead>
            <tbody id="d-lineas"></tbody>
          </table>
          <div style="display:flex;justify-content:flex-end;gap:16px;margin-top:16px;align-items:center;flex-wrap:wrap">
            <span class="eyebrow" style="margin:0">Costo de envío</span>
            <input id="d-envio" type="number" min="0" step="0.01" value="0" style="width:120px;text-align:right">
            <input id="d-envio-nota" placeholder="Nota del envío (opcional)" style="width:210px">
          </div>
          <div style="display:flex;justify-content:flex-end;gap:26px;margin-top:14px;align-items:baseline">
            <span class="eyebrow" style="margin:0">Subtotal</span>
            <span class="mono" id="d-subtotal">$0.00</span>
          </div>
          <div style="display:flex;justify-content:flex-end;gap:26px;margin-top:8px;align-items:baseline">
            <span class="eyebrow" style="margin:0">Total estimado</span>
            <span class="mono" style="font-size:24px;font-weight:600" id="d-total">$0.00</span>
          </div>
          <div class="btn-row" style="margin-top:16px">
            <select id="d-catalogo" style="max-width:260px"></select>
            <button class="btn ghost sm" id="d-add">Agregar producto</button>
          </div>
        </div>

        <div class="card">
          <h3>Comentarios internos</h3>
          <textarea id="d-nota" placeholder="Visible solo para el equipo interno."></textarea>
          <button class="btn ghost sm" id="d-nota-add" style="margin-top:10px">Guardar comentario</button>
        </div>
      </div>

      <div>
        <div class="card">
          <h3>Promociones para este cliente</h3>
          <div id="d-promos"></div>
        </div>
        <div class="card">
          <h3>Acciones</h3>
          <div class="btn-row">
            <button class="btn wa" id="d-wa">Responder por WhatsApp</button>
            <button class="btn ghost" id="d-pdf">Generar PDF</button>
            <button class="btn ghost" id="d-enviar">Enviar al cliente</button>
          </div>
          <div class="sep"></div>
          <h3>Enlace seguro</h3>
          <dl class="kv">
            <dt>URL</dt><dd><span class="token" id="d-link"></span></dd>
            <dt>Token</dt><dd><span class="token" id="d-token"></span></dd>
            <dt>Vence</dt><dd id="d-vence"></dd>
            <dt>Permiso</dt><dd>Cliente: solo lectura · Admin: edición</dd>
          </dl>
        </div>
        <div class="card">
          <h3>Mensaje al cliente</h3>
          <div class="wa-preview">
            <div class="wa-bubble" id="d-msg"></div>
            <div class="wa-meta" id="d-num"></div>
          </div>
        </div>
        <div class="card">
          <h3>Historial</h3>
          <ul class="timeline" id="d-historial"></ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ PROMOCIONES (protegido) ============ -->
<section class="view" id="v-promos">
  <div class="card login" id="pr-bloqueo">
    <p class="eyebrow">Área restringida</p>
    <h1 style="font-size:22px;margin-bottom:6px">Solo administradores</h1>
    <p class="hint">Inicie sesión desde el panel administrativo para crear y editar promociones.</p>
    <button class="btn ghost" style="margin-top:12px" onclick="mostrar('panel')">Ir al inicio de sesión</button>
  </div>

  <div id="pr-contenido" style="display:none">
    <div class="page-head">
      <p class="eyebrow">Reglas comerciales</p>
      <h1>Promociones</h1>
      <p>Las promociones activas aparecen en el catálogo del cliente y quedan disponibles para aplicarlas en cada cotización.</p>
    </div>

    <div class="split">
      <div class="card">
        <h3>Promociones creadas</h3>
        <div id="pr-lista"></div>
      </div>

      <div class="card">
        <h3>Nueva promoción</h3>
        <label class="f"><span>Nombre</span><input id="pr-nombre" placeholder="Ej. Lleve 5 y pague 4"></label>
        <label class="f"><span>Tipo</span>
