         <button data-mas="${p.sku}" aria-label="Agregar uno">+</button>
       </div>`
    : `<button class="add" ${demo?"disabled":`data-mas="${p.sku}"`}>Agregar al pedido</button>`;
  return `<article class="prod ${q?"activo":""}">
    <div class="foto"><img src="${imagenDe(p)}" alt="${escapar(p.nombre)}" loading="lazy"></div>
    <div class="cuerpo">
      <span class="sku">${escapar(p.sku)}</span>
      <span class="nom">${p.destacado?'<i style="font-style:normal;color:var(--amber)">★</i> ':""}${escapar(p.nombre)}</span>
