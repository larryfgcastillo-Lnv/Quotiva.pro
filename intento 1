      ${precioVisible(p)?`<span class="precio">${money(p.precio)}</span>`:""}
      ${promo?`<span class="promo-tag">${escapar(textoPromo(promo))}</span>`:""}
      <div class="pie">${control}</div>
    </div></article>`;
