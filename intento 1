const fmtHora = d => new Date(d).toLocaleString("es-HN",{day:"2-digit",month:"short",hour:"2-digit",minute:"2-digit"});
const escapar = s => String(s).replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));
function fechaEn(dias){ return new Date(Date.now()+dias*864e5).toISOString().slice(0,10); }
