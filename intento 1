/* ================== promociones: vigencia y cálculo ================== */
const vigente = p => p.activa && new Date(p.hasta+"T23:59:59") >= new Date();
function promosPara(q){
  return promociones.filter(p=>{
    if(!vigente(p)) return false;
    if(p.alcance==="todos") return true;
    if(p.alcance==="cliente") return (q.cliente+" "+q.empresa).toLowerCase().includes(p.valor.toLowerCase());
    return (q.ciudad+" "+q.pais).toLowerCase().includes(p.valor.toLowerCase());
  });
}
function promosDeCatalogo(sku){ return promociones.filter(p=> vigente(p) && (!p.sku || p.sku===sku)); }
function textoPromo(p){
  const base = p.tipo==="cantidad" ? `Compre ${p.x}, reciba ${p.y} gratis` : `${p.pct}% de descuento`;
  return base;
}
function subtotal(l){
  const p = l.promoId ? promociones.find(x=>x.id===l.promoId) : null;
  let cobradas = l.cantidad, pct = l.descuento||0;
  if(p && vigente(p)){
    if(p.tipo==="cantidad"){ cobradas = l.cantidad - Math.floor(l.cantidad/(p.x+p.y))*p.y; }
    else pct = Math.max(pct, p.pct);
  }
  return l.precio*cobradas*(1-pct/100);
}
const sumaLineas = q => q.lineas.reduce((s,l)=>s+subtotal(l),0);
const envioDe = q => +(q.envio||0);
const totalDe = q => sumaLineas(q) + envioDe(q);

