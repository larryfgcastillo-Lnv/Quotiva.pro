const precioVisible = p => opciones.mostrarPrecios && !p.ocultarPrecio;
function tarjeta(p, q, demo){
  const promo = promosDeCatalogo(p.sku).find(x=>x.sku===p.sku);
  const control = q
    ? `<div class="stepper">
         <button data-menos="${p.sku}" aria-label="Quitar uno">−</button>
