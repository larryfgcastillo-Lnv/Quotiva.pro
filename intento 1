        const monto = precioVisible(p) ? `<span class="mono">${money(p.precio*q)}</span>` : "";
        return `<li><span>${escapar(p.nombre)} <span class="q">×${q}</span></span>${monto||`<span class="q">${q} ${escapar(p.unidad||"u")}</span>`}</li>`; }).join("")
