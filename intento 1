function abrirDetalle(q){
  if(!esAdmin){ toast("Necesita iniciar sesión como administrador."); return; }
  abierta = q; q.leida = true;
  mostrar("panel"); aplicarSesion();
  dom("d-folio").textContent = q.folio;
  dom("d-estado").innerHTML = pill(q.estado);
  dom("d-cambiar").value = q.estado;
  dom("d-info").innerHTML = `
    <dt>Recibida</dt><dd>${fmtHora(q.creada)}</dd>
    <dt>Cliente</dt><dd>${escapar(q.cliente)}</dd>
    <dt>Empresa</dt><dd>${escapar(q.empresa)}</dd>
    <dt>Contacto</dt><dd>${escapar(q.correo)} · ${escapar(q.telefono)}</dd>
    <dt>WhatsApp</dt><dd class="mono">${escapar(q.whatsapp)}</dd>
    <dt>Ubicación</dt><dd>${escapar(q.ciudad)}, ${q.pais}</dd>
    <dt>Responsable</dt><dd>${q.responsable}</dd>
    <dt>Comentarios</dt><dd>${escapar(q.comentarios)||"<span style='color:var(--slate);font-weight:400'>Sin comentarios</span>"}</dd>`;
  dom("d-link").textContent = enlaceDe(q);
  dom("d-token").textContent = q.token;
  dom("d-vence").textContent = fmt(q.vence);
  dom("d-catalogo").innerHTML = catalogo.map(p=>`<option value="${p.sku}">${escapar(p.nombre)} · ${money(p.precio)}</option>`).join("");
  pintarLineas(q); pintarHistorial(q); pintarMensaje(q); pintarPromosCliente(q);
  window.scrollTo({top:0});
}
dom("d-volver").onclick = ()=>{ abierta=null; aplicarSesion(); pintarLista(); };

function pintarLineas(q){
  const disp = promosPara(q);
  dom("d-lineas").innerHTML = q.lineas.map((l,i)=>{
    const opts = disp.filter(p=> !p.sku || p.sku===l.sku);
    return `<tr>
      <td>${escapar(l.nombre)}<div class="hint mono">${l.sku}</div></td>
      <td class="num"><input class="w-70" type="number" min="1" value="${l.cantidad}" data-f="cantidad" data-i="${i}"></td>
      <td class="num"><input class="w-90" type="number" min="0" step="0.01" value="${l.precio}" data-f="precio" data-i="${i}"></td>
      <td><select data-f="promoId" data-i="${i}">
        <option value="">Sin promoción</option>
        ${opts.map(p=>`<option value="${p.id}" ${l.promoId===p.id?"selected":""}>${escapar(p.nombre)}</option>`).join("")}
      </select></td>
      <td class="num"><input class="w-70" type="number" min="0" max="100" value="${l.descuento}" data-f="descuento" data-i="${i}"></td>
      <td class="num">${money(subtotal(l))}</td></tr>`;
  }).join("");
  dom("d-lineas").querySelectorAll("input,select").forEach(el=>{
    el.onchange = e=>{
      const l = q.lineas[+e.target.dataset.i], f = e.target.dataset.f;
      l[f] = f==="promoId" ? (e.target.value? +e.target.value : null) : Math.max(0,+e.target.value||0);
      pintarLineas(q);
      registrar(q, f==="promoId"
        ? (l.promoId ? "Promoción aplicada a «"+l.nombre+"»" : "Promoción retirada de «"+l.nombre+"»")
        : "Se actualizó «"+l.nombre+"» ("+f+")");
    };
  });
  dom("d-subtotal").textContent = money(sumaLineas(q));
  dom("d-envio").value = envioDe(q);
  dom("d-envio-nota").value = q.envioNota||"";
  dom("d-total").textContent = money(totalDe(q));
}
function pintarPromosCliente(q){
  const ps = promosPara(q);
  dom("d-promos").innerHTML = ps.length ? ps.map(p=>`
    <div class="promo-card"><div class="body">
      <h4>${escapar(p.nombre)}</h4>
      <div class="hint" style="margin:0">${escapar(textoPromo(p))} · ${p.sku? p.sku : "todos los productos"} · vence ${fmt(p.hasta)}</div>
    </div><button class="btn ghost sm" data-p="${p.id}">Aplicar</button></div>`).join("")
    : `<p class="hint" style="margin:0">No hay promociones vigentes para este cliente.</p>`;
  dom("d-promos").querySelectorAll("[data-p]").forEach(b=> b.onclick = ()=>{
    const p = promociones.find(x=>x.id===+b.dataset.p);
    let n=0;
    q.lineas.forEach(l=>{ if(!p.sku || p.sku===l.sku){ l.promoId=p.id; n++; } });
    pintarLineas(q);
    toast(n? "Promoción aplicada a "+n+" línea(s)." : "Ningún producto de esta cotización califica.");
    if(n) registrar(q,"Promoción «"+p.nombre+"» aplicada");
  });
}
function pintarHistorial(q){ dom("d-historial").innerHTML = q.historial.map(h=>`<li><time>${fmtHora(h.t)}</time>${escapar(h.texto)}</li>`).join(""); }
function mensajeDe(q){
  return empresa.mensaje.replaceAll("{cliente}",q.cliente).replaceAll("{folio}","#"+q.folio)
    .replaceAll("{enlace}",enlaceDe(q)).replaceAll("{empresa}",empresa.nombre);
}
/* arma sola la cotización completa lista para enviar por WhatsApp */
function cotizacionTexto(q){
  const lineas = q.lineas.map(l=>{
    const pr = l.promoId ? promociones.find(x=>x.id===l.promoId) : null;
    const prod = catalogo.find(x=>x.sku===l.sku);
    return "• "+l.nombre+"\n   "+l.cantidad+" "+(prod?.unidad||"u")+" x "+money(l.precio)+
      (pr? "  ("+textoPromo(pr)+")":"")+"  =  "+money(subtotal(l));
  }).join("\n");
  return mensajeDe(q)+"\n\n"+
    "*COTIZACIÓN "+q.folio+"*\n"+
    "Cliente: "+q.cliente+(q.empresa? " · "+q.empresa:"")+"\n"+
    "Fecha: "+fmt(q.creada)+"\n"+
    "Válida hasta: "+fmt(q.vence)+"\n"+
    "--------------------------------\n"+lineas+"\n"+
    "--------------------------------\n"+
    "Subtotal: "+money(sumaLineas(q))+"\n"+
    (envioDe(q)>0 ? "Envío"+(q.envioNota? " ("+q.envioNota+")":"")+": "+money(envioDe(q))+"\n" : "")+
    "*TOTAL: "+money(totalDe(q))+"*\n\n"+
    empresa.nombre+(empresa.telefono? " · "+empresa.telefono:"")+
    (empresa.horario? "\nAtención: "+empresa.horario:"");
}
function pintarMensaje(q){ burbuja(dom("d-msg"), cotizacionTexto(q)); dom("d-num").textContent = "De +"+empresa.whatsapp+" → "+q.whatsapp; }

dom("d-cambiar").onchange = e=>{ abierta.estado=e.target.value; dom("d-estado").innerHTML=pill(abierta.estado); registrar(abierta,"Estado cambiado a «"+abierta.estado+"»"); toast("Estado actualizado."); };
dom("d-add").onclick = ()=>{
  const p = catalogo.find(x=>x.sku===dom("d-catalogo").value);
  const ya = abierta.lineas.find(l=>l.sku===p.sku);
  if(ya) ya.cantidad++; else abierta.lineas.push({sku:p.sku,nombre:p.nombre,precio:p.precio,cantidad:1,descuento:0,promoId:null});
  pintarLineas(abierta); registrar(abierta,"Producto agregado: "+p.nombre);
};
dom("d-envio").onchange = ()=>{
  abierta.envio = Math.max(0, +dom("d-envio").value||0);
  guardar(); pintarLineas(abierta); pintarMensaje(abierta); pintarLista();
  registrar(abierta, "Costo de envío: "+money(abierta.envio));
};
dom("d-envio-nota").onchange = ()=>{ abierta.envioNota = dom("d-envio-nota").value.trim(); guardar(); pintarMensaje(abierta); };
dom("d-nota-add").onclick = ()=>{
  const t = dom("d-nota").value.trim();
  if(!t){ toast("Escriba el comentario antes de guardarlo."); return; }
  abierta.notas.push(t); dom("d-nota").value="";
